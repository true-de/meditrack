# ===============================================================
# MediTrack - environment variable template
# Copy to .env (local) or set these in the Render dashboard.
# NEVER commit real secrets. .env is git-ignored.
# ===============================================================

# ---------------------------------------------------------------
# Firebase Admin SDK credentials (REQUIRED in production)
# ---------------------------------------------------------------
# On Render: paste the service-account JSON as a single-line value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local development alternative: path to the git-ignored key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: force a project id (otherwise read from the credential).
FIREBASE_PROJECT_ID=meditrack-3a681

# ---------------------------------------------------------------
# Flask session signing key (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------
SECRET_KEY=

# ---------------------------------------------------------------
# Authorization enforcement
# ---------------------------------------------------------------
# unset -> enforced automatically whenever Firebase is configured (recommended)
# "1"   -> always enforced (use in production)
# "0"   -> disabled (local JSON-only development ONLY; never in production)
MEDITRACK_AUTH_REQUIRED=
# Owner used only when enforcement is disabled (local fallback).
MEDITRACK_LOCAL_OWNER=local-dev

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
# JSON fallback folder (keep the backups).
MEDITRACK_DATA_DIR=data
# "1" enables the interactive debugger. NEVER enable in production.
FLASK_DEBUG=0
# Render injects PORT automatically; HOST defaults to 127.0.0.1 locally.
# HOST=0.0.0.0
