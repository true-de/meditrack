rules_version = '2';

// ===============================================================
// MediTrack - Firestore client security rules
// ---------------------------------------------------------------
// The application accesses Firestore ONLY through the Firebase Admin
// SDK on the Flask server (which bypasses these rules). The browser
// never queries Firestore directly — it calls the protected Flask API
// with a Firebase ID token, and Flask enforces per-user ownership.
//
// Therefore ALL direct client access is denied by default.
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
